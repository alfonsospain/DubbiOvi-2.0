{
  "appId": "com.dubbiovi.app",
  "productName": "DubbiOvi",
  "asar": false,
  "directories": {
    "output": "dist"
  },
  "files": [
    "main.js",
    "preload.js",
    "*.js",
    "lib/**/*",
    ".next/standalone/**/*",
    "package.json",
    "THIRD-PARTY-LICENSES",
    "licenses/**/*",
    "docs/licenses/**/*",
    "!node_modules/@img/**/*",
    "!node_modules/sharp/**/*",
    "!node_modules/@next/swc-darwin-arm64/**/*",
    "!node_modules/@next/swc-darwin-x64/**/*",
    "!node_modules/**/*.node",
    "!node_modules/**/*.dylib"
  ],
  "mac": {
    "target": [
      {
        "target": "dmg",
        "arch": ["universal"]
      }
    ],
    "extraResources": [
      {
        "from": "bin",
        "to": "bin",
        "filter": [
          "ffmpeg",
          "ffprobe"
        ]
      }
    ],
    "x64ArchFiles": "**/bin/*",
    "icon": "build/icon.icns",
    "category": "public.app-category.education",
    "fileAssociations": [
      {
        "ext": "dubbiovi",
        "name": "DubbiOvi Project",
        "description": "DubbiOvi Project File",
        "role": "Editor",
        "icon": "build/icon.icns"
      }
    ]
  },
  "dmg": {
    "background": null,
    "iconSize": 100,
    "contents": [
      {
        "x": 130,
        "y": 150,
        "type": "file"
      },
      {
        "x": 410,
        "y": 150,
        "type": "link",
        "path": "/Applications"
      }
    ]
  },
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ],
    "extraResources": [
      {
        "from": "bin",
        "to": "bin",
        "filter": [
          "ffmpeg.exe",
          "ffprobe.exe"
        ]
      }
    ],
    "icon": "build/icon.ico",
    "fileAssociations": [
      {
        "ext": "dubbiovi",
        "name": "DubbiOvi Project",
        "description": "DubbiOvi Project File",
        "role": "Editor",
        "icon": "build/icon.ico"
      }
    ]
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "DubbiOvi"
  }
}
